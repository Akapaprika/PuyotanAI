# =============================================================================
# PuyotanAI .gitignore
# =============================================================================

# --- Personal & Secret / Site Analysis Files ---
memo.md
site_main.js
scratch/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyd
.pytest_cache/
.coverage
htmlcov/
.ipynb_checkpoints/
.venv/
venv/
env/
build/
dist/

# --- C++ / CMake / Visual Studio Build Artifacts ---
native/build*/
native/dist/
native/Debug/
native/Release/
native/x64/
native/x86/
native/Debug
native/Release
.vs/
native/.vs/
out/

# Object & Binary files
*.obj
*.o
*.lib
*.a
*.exp
*.exe
*.dll
*.so
*.dylib

# Debug & Profile files
*.pdb
*.ilk
*.idb
*.iobj
*.ipdb
*.pyd.recipe
*.manifest

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeScripts/
Makefile
*.ninja
*.ninja_deps
*.ninja_log

# --- Test Artifacts & Benchmark Dumps ---
tests/*.txt
bench_results_*.json
*.log

# --- IDEs & OS Files ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
